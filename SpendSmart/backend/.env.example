# Copy to .env for local development (do NOT commit the real .env).
# On Render, set these as environment variables in the dashboard instead.

# PostgreSQL connection string.
#
# Aiven (recommended cloud DB) — copy the "Service URI" from the Aiven
# console. It already ends with ?sslmode=require, which is required:
# DATABASE_URL=postgres://avnadmin:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require
#
# Local development example:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/spendsmart

# Secret used to sign JWT tokens — use a long random string in production.
SECRET_KEY=spendsmart_secret_key_change_me

# Optional: set to "true" to enable Flask debug mode locally.
FLASK_DEBUG=false
